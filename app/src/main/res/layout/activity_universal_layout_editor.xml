<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutEditorFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014">

    <LinearLayout
        android:id="@+id/layoutEditorToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC000000"
        android:paddingEnd="8dp"
        android:paddingRight="8dp">

        <ImageButton
            android:id="@+id/layoutEditorBackButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:padding="14dp"
            android:contentDescription="@string/back"
            style="?android:attr/borderlessButtonStyle"/>

        <TextView
            android:id="@+id/layoutEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceLarge"/>

        <Button
            android:id="@+id/layoutEditorMoveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/title_edit_controls"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/layoutEditorImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/title_pick_image"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/layoutEditorResetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/title_reset_controls"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!--
        The universal layout is added into this frame at runtime, exactly as it is added
        over the stream, so the editor always shows the real controls. It sits below the
        toolbar, otherwise the controls near the top edge would be unreachable.
    -->
    <FrameLayout
        android:id="@+id/layoutEditorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutEditorToolbar"/>

    <TextView
        android:id="@+id/layoutEditorHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:padding="10dp"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="13sp"/>

</RelativeLayout>
