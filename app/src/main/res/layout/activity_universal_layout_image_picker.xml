<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imagePickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014">

    <ImageButton
        android:id="@+id/imagePickerBackButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:src="@drawable/ic_back"
        android:scaleType="fitCenter"
        android:padding="14dp"
        android:contentDescription="@string/back"
        style="?android:attr/borderlessButtonStyle"/>

    <TextView
        android:id="@+id/imagePickerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/imagePickerBackButton"
        android:layout_toRightOf="@id/imagePickerBackButton"
        android:layout_marginTop="16dp"
        android:text="@string/title_pick_image"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/imagePickerDefaultButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="6dp"
        android:minWidth="0dp"
        android:text="@string/title_use_default_image"
        style="?android:attr/borderlessButtonStyle"
        android:textColor="#FFFFFF"/>

    <GridView
        android:id="@+id/imagePickerGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/imagePickerBackButton"
        android:numColumns="auto_fit"
        android:columnWidth="120dp"
        android:horizontalSpacing="6dp"
        android:verticalSpacing="6dp"
        android:stretchMode="spacingWidthUniform"
        android:padding="6dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"/>

    <ProgressBar
        android:id="@+id/imagePickerProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"/>

    <TextView
        android:id="@+id/imagePickerEmptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:padding="24dp"
        android:gravity="center"
        android:text="@string/msg_no_images"
        android:textColor="#B0B0B8"
        android:textSize="15sp"/>

</RelativeLayout>
