<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101014">

    <!-- Toolbar -->
    <ImageButton
        android:id="@+id/layoutsBackButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:src="@drawable/ic_back"
        android:scaleType="fitCenter"
        android:padding="14dp"
        android:contentDescription="@string/back"
        style="?android:attr/borderlessButtonStyle"/>

    <TextView
        android:id="@+id/layoutsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/layoutsBackButton"
        android:layout_toRightOf="@id/layoutsBackButton"
        android:layout_centerVertical="false"
        android:layout_marginTop="16dp"
        android:text="@string/title_universal_layouts"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="#FFFFFF"/>

    <ImageButton
        android:id="@+id/layoutsImportButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@id/layoutsAddButton"
        android:layout_toLeftOf="@id/layoutsAddButton"
        android:src="@drawable/ic_import"
        android:scaleType="fitCenter"
        android:padding="16dp"
        android:contentDescription="@string/title_import_layout"
        style="?android:attr/borderlessButtonStyle"/>

    <ImageButton
        android:id="@+id/layoutsAddButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:src="@drawable/ic_add"
        android:scaleType="fitCenter"
        android:padding="16dp"
        android:contentDescription="@string/title_add_layout"
        style="?android:attr/borderlessButtonStyle"/>

    <TextView
        android:id="@+id/layoutsInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutsBackButton"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/msg_layouts_help"
        android:textColor="#B0B0B8"
        android:textSize="13sp"/>

    <GridView
        android:id="@+id/layoutsGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutsInfoText"
        android:numColumns="auto_fit"
        android:columnWidth="150dp"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        android:stretchMode="spacingWidthUniform"
        android:padding="8dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"/>

    <TextView
        android:id="@+id/layoutsEmptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:text="@string/msg_no_layouts"
        android:textColor="#B0B0B8"
        android:textSize="16sp"/>

</RelativeLayout>
